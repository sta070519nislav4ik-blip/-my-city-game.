<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"><meta name="apple-mobile-web-app-capable" content="yes"><title>Космический побег</title><style>*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#05091c;font-family:system-ui,-apple-system,sans-serif;touch-action:none}canvas{width:100%;height:100%;display:block;touch-action:none}.hud{position:fixed;top:max(16px,env(safe-area-inset-top));left:15px;right:15px;display:flex;justify-content:space-between;gap:10px;pointer-events:none;color:white;font-size:16px;font-weight:800;text-shadow:0 2px 8px #000}.hud span{background:#101b39aa;border:1px solid #6476a255;border-radius:15px;padding:9px 12px}.overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#0309178c;color:white;padding:24px}.panel{width:min(350px,100%);background:linear-gradient(155deg,#1d315eec,#0a1233f5);border:1px solid #90bfff77;border-radius:28px;padding:28px 22px;text-align:center;box-shadow:0 15px 65px #000a}.panel h1{font-size:29px;margin:10px 0}.panel p{line-height:1.5;color:#d4e5ff}.rocketIcon{font-size:64px;filter:drop-shadow(0 0 20px #40dfff)}button{font-size:18px;font-weight:900;background:linear-gradient(90deg,#46e2ff,#8c7dff);color:#091735;border:0;border-radius:17px;padding:16px 30px;width:100%;margin-top:14px}.small{font-size:13px;color:#afc9e8!important}.hide{display:none}</style></head><body><canvas id="c"></canvas><div class="hud"><span>⭐ <b id="score">0</b></span><span>🏆 <b id="best">0</b></span><span>❤️ <b id="lives">3</b></span></div><div class="overlay" id="overlay"><div class="panel"><div class="rocketIcon">🚀</div><h1 id="heading">Космический побег</h1><p id="message">Управляй ракетой пальцем. Уворачивайся от астероидов и космического мусора, собирай золотые звёзды!</p><button id="start">🚀 Полетели!</button><p class="small">Игра работает прямо в Safari на iPhone</p></div></div><script>
(()=>{'use strict';const c=document.getElementById('c'),g=c.getContext('2d'),ui={overlay:document.getElementById('overlay'),heading:document.getElementById('heading'),message:document.getElementById('message'),start:document.getElementById('start'),score:document.getElementById('score'),best:document.getElementById('best'),lives:document.getElementById('lives')};let w=0,h=0,dpr=1,mode='menu',time=0,last=0,spawn=0,points=0,lives=3,invul=0,objects=[],stars=[],particles=[],pointer=null;let best=0;try{best=Number(localStorage.getItem('rocket-best')||0)}catch(e){}ui.best.textContent=best;const ship={x:0,y:0,r:19};const rand=(a,b)=>a+Math.random()*(b-a);const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));function resize(){w=innerWidth;h=innerHeight;dpr=Math.min(devicePixelRatio||1,2);c.width=Math.round(w*dpr);c.height=Math.round(h*dpr);g.setTransform(dpr,0,0,dpr,0,0);ship.y=h*.78;ship.x=ship.x?clamp(ship.x,25,w-25):w/2;stars=Array.from({length:85},()=>({x:rand(0,w),y:rand(0,h),r:rand(.5,2),v:rand(20,100),a:rand(.2,1)}))}addEventListener('resize',resize);resize();function startGame(){points=0;lives=3;time=0;spawn=0;invul=0;objects=[];particles=[];ship.x=w/2;mode='play';ui.overlay.classList.add('hide');updateUI()}function updateUI(){ui.score.textContent=Math.floor(points);ui.lives.textContent=lives;ui.best.textContent=best}ui.start.onclick=startGame;function endGame(){mode='over';best=Math.max(best,Math.floor(points));try{localStorage.setItem('rocket-best',String(best))}catch(e){}ui.heading.textContent='Полёт завершён!';ui.message.textContent='Твои очки: '+Math.floor(points)+' · Рекорд: '+best+'. Попробуй ещё раз и побей свой рекорд!';ui.start.textContent='🔁 Играть снова';ui.overlay.classList.remove('hide');updateUI()}function spawnObject(){const r=Math.random();objects.push({type:r<.19?'star':r<.57?'junk':'rock',x:rand(25,w-25),y:-45,r:r<.19?15:rand(18,31),vy:rand(155,235)+time*3,spin:rand(-3,3),angle:rand(0,6),shape:Math.floor(rand(0,3))})}function burst(x,y,color,n){for(let i=0;i<n;i++)particles.push({x,y,vx:rand(-140,140),vy:rand(-140,140),life:rand(.3,.8),max:.8,color,r:rand(2,5)})}function starShape(x,y,r,fill){g.save();g.translate(x,y);g.beginPath();for(let i=0;i<10;i++){let a=-Math.PI/2+i*Math.PI/5,rr=i%2?r*.48:r;g.lineTo(Math.cos(a)*rr,Math.sin(a)*rr)}g.closePath();g.fillStyle=fill;g.fill();g.restore()}function drawRocket(){g.save();g.translate(ship.x,ship.y);if(invul>0&&Math.floor(invul*12)%2===0)g.globalAlpha=.45;const flame=24+Math.sin(time*28)*8;let grad=g.createLinearGradient(0,12,0,flame+25);grad.addColorStop(0,'#fff8a6');grad.addColorStop(.4,'#ff9b38');grad.addColorStop(1,'#ff3e55');g.fillStyle=grad;g.beginPath();g.moveTo(-9,17);g.lineTo(0,flame+18);g.lineTo(9,17);g.fill();g.shadowBlur=18;g.shadowColor='#63dbff';g.fillStyle='#a6e7ff';g.beginPath();g.moveTo(0,-33);g.bezierCurveTo(21,-17,18,14,13,22);g.lineTo(-13,22);g.bezierCurveTo(-18,14,-21,-17,0,-33);g.fill();g.shadowBlur=0;g.fillStyle='#f04d78';g.beginPath();g.moveTo(0,-33);g.lineTo(-10,-17);g.lineTo(10,-17);g.fill();g.fillStyle='#427cff';g.beginPath();g.moveTo(-13,3);g.lineTo(-25,24);g.lineTo(-12,18);g.lineTo(12,18);g.lineTo(25,24);g.lineTo(13,3);g.fill();g.fillStyle='#154675';g.beginPath();g.arc(0,-7,9,0,7);g.fill();g.fillStyle='#73f4ff';g.beginPath();g.arc(-2,-9,6,0,7);g.fill();g.restore()}function drawObject(o){g.save();g.translate(o.x,o.y);g.rotate(o.angle);if(o.type==='star'){g.shadowBlur=20;g.shadowColor='#ffda4c';starShape(0,0,o.r,'#ffdd54');g.shadowBlur=0;starShape(0,0,o.r*.56,'#fff4a7')}else if(o.type==='junk'){g.fillStyle='#8698b5';g.fillRect(-o.r*.6,-o.r*.45,o.r*1.2,o.r*.9);g.fillStyle='#4b668e';g.fillRect(-o.r*1.2,-o.r*.25,o.r*.5,o.r*.5);g.fillRect(o.r*.7,-o.r*.25,o.r*.5,o.r*.5);g.fillStyle='#c4d4e8';g.fillRect(-o.r*.32,-o.r*.24,o.r*.64,o.r*.48);g.strokeStyle='#344967';g.lineWidth=2;g.strokeRect(-o.r*.6,-o.r*.45,o.r*1.2,o.r*.9)}else{g.beginPath();for(let i=0;i<9;i++){let a=i*Math.PI*2/9,rr=o.r*(.8+.17*Math.sin(i*7+o.shape));g.lineTo(Math.cos(a)*rr,Math.sin(a)*rr)}g.closePath();g.fillStyle='#8e8395';g.fill();g.strokeStyle='#c2aeb1';g.lineWidth=3;g.stroke();g.fillStyle='#635d70';g.beginPath();g.arc(-o.r*.2,-o.r*.15,o.r*.23,0,7);g.arc(o.r*.35,o.r*.25,o.r*.15,0,7);g.fill()}g.restore()}function frame(ms){let dt=Math.min((ms-last)/1000||0,.035);last=ms;g.clearRect(0,0,w,h);const bg=g.createLinearGradient(0,0,w,h);bg.addColorStop(0,'#050b22');bg.addColorStop(.55,'#10214b');bg.addColorStop(1,'#250c3e');g.fillStyle=bg;g.fillRect(0,0,w,h);let neb=g.createRadialGradient(w*.7,h*.25,10,w*.7,h*.25,w*.65);neb.addColorStop(0,'#7837a22e');neb.addColorStop(1,'#00000000');g.fillStyle=neb;g.fillRect(0,0,w,h);for(const s of stars){s.y+=(mode==='play'?s.v: s.v*.25)*dt;if(s.y>h){s.y=0;s.x=rand(0,w)}g.globalAlpha=s.a;g.fillStyle='#dceeff';g.beginPath();g.arc(s.x,s.y,s.r,0,7);g.fill()}g.globalAlpha=1;if(mode==='play'){time+=dt;points+=dt*5;invul=Math.max(0,invul-dt);spawn-=dt;if(spawn<=0){spawnObject();spawn=Math.max(.32,.9-time*.008)}if(pointer!==null)ship.x+= (clamp(pointer,25,w-25)-ship.x)*Math.min(1,dt*13);for(let i=objects.length-1;i>=0;i--){let o=objects[i];o.y+=o.vy*dt;o.angle+=o.spin*dt;if(o.y>h+50){objects.splice(i,1);continue}let dx=o.x-ship.x,dy=o.y-(ship.y-4);if(dx*dx+dy*dy<(o.r+15)**2){objects.splice(i,1);if(o.type==='star'){points+=30;burst(o.x,o.y,'#ffe46e',13)}else if(invul<=0){lives--;invul=1.5;burst(ship.x,ship.y,'#ff779b',22);if(lives<=0){endGame();break}}}}updateUI()}for(const o of objects)drawObject(o);if(mode==='play')drawRocket();for(let i=particles.length-1;i>=0;i--){let p=particles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;if(p.life<=0){particles.splice(i,1);continue}g.globalAlpha=Math.max(0,p.life/p.max);g.fillStyle=p.color;g.beginPath();g.arc(p.x,p.y,p.r,0,7);g.fill()}g.globalAlpha=1;requestAnimationFrame(frame)}c.addEventListener('pointerdown',e=>{if(mode==='play'){pointer=e.clientX;c.setPointerCapture(e.pointerId)}});c.addEventListener('pointermove',e=>{if(mode==='play'&&pointer!==null)pointer=e.clientX});c.addEventListener('pointerup',()=>pointer=null);c.addEventListener('pointercancel',()=>pointer=null);requestAnimationFrame(frame)})();
</script></body></html>
